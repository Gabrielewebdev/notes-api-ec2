#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

install -d -m 700 /etc/notes-api

cat > /etc/notes-api/environment <<'ENV'
NOTES_BACKEND=dynamodb
NOTES_TABLE_NAME=${table_name}
AWS_REGION=us-east-1
ENV

chmod 600 /etc/notes-api/environment

cat > /usr/local/bin/start-notes-api <<'SCRIPT'
#!/bin/bash
set -euo pipefail

aws ecr get-login-password --region us-east-1 |
  docker login --username AWS --password-stdin 726862573245.dkr.ecr.us-east-1.amazonaws.com

docker pull '${image_uri}'
docker logout 726862573245.dkr.ecr.us-east-1.amazonaws.com
docker rm -f notes-api || true

exec docker run --name notes-api \
  --env-file /etc/notes-api/environment \
  --publish 8000:8000 \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --log-driver awslogs \
  --log-opt awslogs-region=us-east-1 \
  --log-opt awslogs-group=/notes-api-ec2/api \
  --log-opt awslogs-stream="$(cat /proc/sys/kernel/random/uuid)" \
  --log-opt mode=non-blocking \
  --log-opt max-buffer-size=4m \
  '${image_uri}'
SCRIPT

chmod 700 /usr/local/bin/start-notes-api

cat > /etc/systemd/system/notes-api.service <<'UNIT'
[Unit]
Description=Notes API container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/start-notes-api
ExecStop=-/usr/bin/docker stop -t 20 notes-api
Restart=always
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now notes-api.service
